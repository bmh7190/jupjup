# 필수: 공공데이터포털 일반 인증키(Decoding 또는 Encoding 키 모두 가능)
# 경찰청 분실물정보·습득물정보·포털기관 습득물정보 활용 승인이 필요합니다.
DATA_GO_KR_SERVICE_KEY=

# 필수: 자연어 조건 추출과 Agent 대화에 사용합니다.
# 실제 키를 저장소에 커밋하지 마세요.
OPENAI_API_KEY=
# 사용할 OpenAI 모델
OPENAI_MODEL=gpt-5.4-mini

# 한 페이지 요청 건수(1~100)
LOST112_PAGE_SIZE=10
# 개별 HTTP 요청 최대 대기 시간(초, 최소 1)
LOST112_TIMEOUT_SECONDS=15
# 출처별 상세 정보를 보완할 상위 레코드 수(0이면 상세 조회 안 함)
LOST112_DETAIL_LIMIT=5
# 출처·날짜 구간별 최대 페이지 수(최소 1)
LOST112_MAX_PAGES_PER_WINDOW=10
# 날짜 검색 전체 시간 예산(초). 후보가 있으면 초과 시 일부 조회로 반환합니다.
LOST112_SEARCH_BUDGET_SECONDS=30
